 "captions": [
  {
   "start": 108,
   "end": 190,
   "tag": "КОМПЛЕКТАЦИЯ",
   "text": "Робот-погрузчик на линейном треке берёт детали из кассеты комплекта: фланец ложится на стенд сборки, пневмоприжимы фиксируют его",
   "key": "flange",
   "shot": "S2_02_flange"
  },
  {
   "start": 198,
   "end": 279,
   "tag": "СБОРКА",
   "text": "Отвод ставится на фланец по центрирующим упорам и V-призме — положение задаёт оснастка, а не ручная разметка",
   "key": "elbow",
   "shot": "S2_03_elbow"
  },
  {
   "start": 287,
   "end": 384,
   "tag": "СБОРКА · ЗАЗОР",
   "text": "Труба укладывается в ложемент до упора, датчик проверяет зазор стыка перед прихваткой",
   "key": "pipe",
   "shot": "S2_04_pipe"
  },
  {
   "start": 392,
   "end": 481,
   "tag": "ПРИХВАТКА",
   "text": "Малый сварочный робот ставит по три прихватки на каждый стык — сборка фиксируется без ручного труда",
   "key": "tack",
   "shot": "S2_05_tackA"
  },
  {
   "start": 489,
   "end": 572,
   "tag": "ПЕРЕНОС",
   "text": "Прихваченный спул забирается целиком: один комплект деталей — один спул",
   "key": "carry",
   "shot": "S2_07_pick"
  },
  {
   "start": 580,
   "end": 664,
   "tag": "ЗАГРУЗКА ЯЧЕЙКИ",
   "text": "Сварочный робот в исходной позиции, световая завеса в режиме muting: погрузчик ставит спул на планшайбу, прижимы фиксируют фланец",
   "key": "load",
   "shot": "S2_08_load"
  },
  {
   "start": 672,
   "end": 741,
   "tag": "ПЕРЕДАЧА В СВАРКУ",
   "text": "Погрузчик выходит за ограждение, позиционер разворачивает изделие в исходное положение для сварки",
   "key": "ready",
   "shot": "S2_09_ready"
  },
  {
   "start": 1499,
   "end": 1563,
   "tag": "СВАРКА ЗАВЕРШЕНА",
   "text": "Оба стыка сварены: сварочный робот уходит в исходную позицию, позиционер возвращает изделие в позицию выгрузки",
   "key": "done",
   "shot": "S2_10_done"
  },
  {
   "start": 1571,
   "end": 1648,
   "tag": "ВЫГРУЗКА",
   "text": "Прижимы планшайбы освобождают фланец, погрузчик забирает спул из ячейки",
   "key": "unload",
   "shot": "S2_11_unload"
  },
  {
   "start": 1656,
   "end": 1713,
   "tag": "ВЫХОДНОЙ РОЛЬГАНГ",
   "text": "Спул ставится на паллету-спутник и уходит по рольгангу на пост маркировки и контроля",
   "key": "carrier",
   "shot": "S2_12_carrier"
  },
  {
   "start": 1721,
   "end": 1774,
   "tag": "МАРКИРОВКА",
   "text": "Лазерный маркер наносит ID спула и номер WPS — прослеживаемость до каждого шва",
   "key": "mark",
   "shot": "S2_14_mark"
  },
  {
   "start": 1782,
   "end": 1869,
   "tag": "КОНТРОЛЬ",
   "text": "Лазерный профилометр сканирует шов, геометрия валика сравнивается с допусками; результат сохраняется по ID спула",
   "key": "scan",
   "shot": "S2_15_scan"
  },
  {
   "start": 1877,
   "end": 2048,
   "tag": "СКЛАДИРОВАНИЕ",
   "text": "Погрузчик укладывает готовый спул в стеллаж; на стенде сборки уже лежит фланец следующего комплекта",
   "key": "store",
   "shot": "S2_16_store"
  }
 ],
